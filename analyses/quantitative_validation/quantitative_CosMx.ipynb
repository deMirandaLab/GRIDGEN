    "# Build the comprehensive dictionary with all file paths\n",
    "fov_data = {}\n",
    "\n",
    "for fov_num in selected_fov_numbers:\n",
    "    fov_name = f'FOV{fov_num}'\n",
    "    \n",
    "    # Find the CosMx target call file\n",
    "    cosmx_folder = os.path.join(cosmx_path_s0, fov_name)\n",
